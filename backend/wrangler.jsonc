{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "factory2d-community",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "factory2d-community",
      // Local development placeholder, not a provisioned Cloudflare database ID.
      // Replace with the actual D1 UUID before remote migrations or deployment.
      "database_id": "local-factory2d",
      "migrations_dir": "migrations"
    }
  ]
}
