# Optional development configuration. Omit or leave blank for local/offline development.
# For local development, first run npm run db:migrate:local and npm run dev:backend.
VITE_COMMUNITY_API_URL=http://localhost:8787
# Production uses the public endpoint in .env.production; override with an environment
# variable or .env.production.local (set a blank URL for an offline production build).
# VITE_ values are public and embedded at build time. Never put API tokens here.
